{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@adrian-badilla/ui/landing-page": [
        "./libs/adrian-badilla/frontend/landing-page/src/index.ts"
      ],
      "@adrian-badilla/ui/landing-page/routes": [
        "./libs/adrian-badilla/frontend/landing-page/src/lib/lib.routes.ts"
      ],
      "@adrian-badilla/ui/shared": [
        "./libs/adrian-badilla/frontend/shared/src/index.ts"
      ],
      "@adrian-badilla/ui/shared/*": [
        "./libs/adrian-badilla/frontend/shared/src/lib/*"
      ],
      "@shared/*": ["./libs/adrian-badilla/frontend/shared/*"],
      "@adrian-badilla/auth": [
        "./libs/adrian-badilla/frontend/auth/src/index.ts"
      ],
      "@adrian-badilla/auth/routes": [
        "./libs/adrian-badilla/frontend/auth/src/lib/lib.routes.ts"
      ],
      "@shared/styles/*": [
        "./libs/adrian-badilla/frontend/shared/src/lib/styles/*"
      ],
      "@adrian-badilla/dashboard/routes": [
        "./libs/adrian-badilla/frontend/dashboard/src/lib/lib.routes.ts"
      ],
      "adrian-badilla/products": [
        "./libs/adrian-badilla/frontend/products/src/index.ts"
      ],
      "adrian-badilla/settings": [
        "./libs/adrian-badilla/frontend/settings/src/index.ts"
      ],
      "@adrian-badilla/news": [
        "./libs/adrian-badilla/frontend/news/src/index.ts"
      ],
      "@adrian-badilla/news/routes": [
        "./libs/adrian-badilla/frontend/news/src/lib/news.routes.ts"
      ],
      "@adrian-badilla/home": [
        "./libs/adrian-badilla/frontend/home/src/index.ts"
      ],
      "@adrian-badilla/home/routes": [
        "./libs/adrian-badilla/frontend/home/src/lib/home.routes.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
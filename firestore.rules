rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ──────────────────────────────────────────────────────
    // Each user can only read and write their own profile document.
    // No user can read or modify another user's profile.
    match /users/{uid} {

      // Allow read only if the authenticated user owns this document.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Allow create only for the document owner.
      // Enforce that required fields are present and `isActive` is true.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
             'uid', 'email', 'displayName', 'photoURL',
             'provider', 'createdAt', 'updatedAt', 'lastLoginAt', 'isActive'
           ])
        && request.resource.data.isActive == true;

      // Allow update only for the document owner.
      // Prevent modifying uid or createdAt after creation.
      // Prevent clients from writing the `subscription` field directly —
      // it is managed exclusively by Firebase Functions (admin SDK).
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['subscription']);

      // Deletes are not permitted through the client SDK.
      allow delete: if false;
    }

    // ── users/{uid}/payments ─────────────────────────────────────────────────
    // Payment records are written exclusively by Firebase Functions.
    // Users can only read their own payment history.
    match /users/{uid}/payments/{paymentId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Deny all other paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
